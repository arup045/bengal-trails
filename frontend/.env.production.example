# ─── Vercel Environment Variables ────────────────────────────────────────────
# Set these in your Vercel project → Settings → Environment Variables

# Backend API URL (Render or Railway)
VITE_API_BASE=https://YOUR_RENDER_SERVICE.onrender.com/api

# Production domain — used for SEO canonical URLs, Open Graph, breadcrumb schemas.
# Do NOT add a trailing slash.
VITE_SITE_URL=https://bengaltrails.com

# Sentry DSN for frontend error tracking (optional but recommended)
# VITE_SENTRY_DSN=https://XXXXXXXXXXXXXXXX.ingest.sentry.io/XXXXXXX

# Google Analytics Measurement ID (optional)
# VITE_GA_MEASUREMENT_ID=G-XXXXXXXXXX
