{
  "name": "bengal-trails-backend",
  "version": "1.0.0",
  "description": "Bengal Trails West Bengal Tourism - Backend API",
  "main": "src/index.js",
  "scripts": {
    "start": "node src/db/migrate.js && node src/index.js",
    "dev": "nodemon src/index.js",
    "migrate": "node src/db/migrate.js",
    "seed": "node src/db/seed.js",
    "seed:content": "node src/db/seed-content.js",
    "photos": "node scripts/update-photos.js",
    "migrate:images": "node scripts/migrate-images-to-cloudinary.js",
    "embed": "node scripts/embed-content.js",
    "start:prod": "node scripts/start-production.js",
    "backup": "node scripts/backup-db.js",
    "backup:file": "node scripts/backup-db.js > backups/backup_$(date +%Y%m%d).sql"
  },
  "dependencies": {
    "@sentry/node": "^10.51.0",
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.5.1",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-mongo-sanitize": "^2.2.0",
    "express-rate-limit": "^7.3.1",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^1.4.5-lts.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.12.0",
    "razorpay": "^2.9.6",
    "uuid": "^10.0.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "form-data": "^4.0.5",
    "nodemon": "^3.1.4"
  },
  "engines": {
    "node": ">=18.0.0"
  }
}