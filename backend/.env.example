# Bengal Trails Backend — Environment Variables
# ===============================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to git. Rotate all secrets immediately on exposure.

# ── Server ──────────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development     # use "production" on Render/Railway

# ── Database (PostgreSQL) ───────────────────────────────────────────────────
# Railway: Dashboard → PostgreSQL → Connect
# Render:  Dashboard → PostgreSQL → External Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/bengaltrails_db

# Optional: override max pool size (default 10). Render free tier allows 25 total.
# DATABASE_POOL_MAX=10

# ── JWT ─────────────────────────────────────────────────────────────────────
# Generate: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# Minimum 64 bytes of entropy. Changing this invalidates ALL active sessions.
JWT_SECRET=change_this_to_a_long_random_secret_string_at_least_64_chars

# ── Frontend URL (CORS whitelist) ────────────────────────────────────────────
# Local dev: http://localhost:5173
# Production: your exact Vercel domain (no trailing slash).
# Multiple origins: comma-separated. Never use "*".
FRONTEND_URL=http://localhost:5173

# ── OAuth Callback Base ──────────────────────────────────────────────────────
# REQUIRED in production. Render terminates SSL before your app so req.protocol
# is always "http" — we need this to build correct https:// callback URLs.
API_BASE_URL=https://your-backend.onrender.com

# ── Google OAuth (optional) ──────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Must match what's registered in Google Cloud Console (Authorised redirect URIs)
GOOGLE_CALLBACK_URL=https://your-backend.onrender.com/api/auth/google/callback

# ── Facebook OAuth (optional) ────────────────────────────────────────────────
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=https://your-backend.onrender.com/api/auth/facebook/callback

# ── Email (password reset, newsletters, welcome emails) ──────────────────────
# Any SMTP provider: Gmail App Password, SendGrid, Resend, Mailgun, etc.
# Leave empty in dev — tokens are printed to console instead.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password_or_api_key
EMAIL_FROM="Bengal Trails <noreply@bengaltrails.com>"

# ── Admin Account (first run) ────────────────────────────────────────────────
# The migration creates this admin account automatically on first start.
# Save the password from the console output — it will NOT be printed again.
# PRODUCTION: FIRST_ADMIN_PASSWORD must be 12+ characters.
FIRST_ADMIN_EMAIL=admin@bengaltrails.com
FIRST_ADMIN_PASSWORD=

# ── AI Assistant (Groq — FREE tier) ─────────────────────────────────────────
# https://console.groq.com → API Keys → Create key (30 seconds)
# Free: 14,400 req/day. Leave empty to use built-in keyword bot (no AI needed).
GROQ_API_KEY=

# ── Image Storage (Cloudinary — FREE tier: 25 GB) ────────────────────────────
# https://cloudinary.com → Dashboard → copy the 3 values below.
# Leave empty: uploads return base64 data URLs (dev only, not for production).
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ── Payments (Razorpay) ───────────────────────────────────────────────────────
# https://razorpay.com → Settings → API Keys → Test Mode
# Leave empty: payments run in dev mode (no real money charged).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret: Razorpay Dashboard → Webhooks → your endpoint → Secret
# Without this, webhook endpoint returns 200 without processing (safe default).
RAZORPAY_WEBHOOK_SECRET=

# ── Error Tracking (Sentry — optional) ───────────────────────────────────────
# https://sentry.io → your project → Settings → Client Keys (DSN)
SENTRY_DSN=

# ── Keep-Alive (Render free tier) ────────────────────────────────────────────
# Set this to your Render service URL so the app pings itself every 9 min
# to prevent cold starts on the free tier.
RENDER_EXTERNAL_URL=https://your-backend.onrender.com
