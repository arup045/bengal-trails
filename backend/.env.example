# Bengal Trails Backend - Environment Variables
# =============================================
# Copy this file to .env and fill in your values
# NEVER commit .env to git!

# ---- Server ----
PORT=3000
NODE_ENV=development

# ---- Database (PostgreSQL) ----
# Railway: copy from Railway dashboard -> PostgreSQL -> Connect
# Render:  copy from Render dashboard -> PostgreSQL -> External Database URL
DATABASE_URL=postgresql://user:password@localhost:5432/gobro_db

# ---- JWT ----
# Generate a strong secret: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=change_this_to_a_long_random_secret_string
JWT_EXPIRES_IN=7d

# ---- Frontend URL (for CORS) ----
# Local dev: http://localhost:5173
# Production: https://yourdomain.com
FRONTEND_URL=http://localhost:5173

# ---- Google OAuth (optional) ----
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:3000/api/auth/google/callback

# ---- Email (for password reset, newsletters) ----
# Use any SMTP provider: Gmail, SendGrid, Resend, Mailgun etc.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@gobro.travel

# ---- Admin ----
# Email of the first admin user (set during migration)
FIRST_ADMIN_EMAIL=admin@gobro.com

# ---- Facebook OAuth (optional) ----
FACEBOOK_APP_ID=
FACEBOOK_APP_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/api/auth/facebook/callback

# ---- SMTP / Email ----
# Leave empty to skip email sending (tokens logged to console instead)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=noreply@gobro.travel

# ---- AI (FREE - Groq) ----
# Sign up free at console.groq.com -> API Keys -> Create key (takes 30 seconds)
# Free tier: 14,400 requests/day — more than enough!
GROQ_API_KEY=
# Leave empty to use built-in keyword bot (no AI needed)

# ---- Cloudinary (FREE - 25GB storage) ----
# Sign up at cloudinary.com -> Dashboard -> Copy these 3 values
# Without these, uploads return base64 data URLs (works for dev only)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# ---- Razorpay (Indian payment gateway) ----
# Sign up at razorpay.com -> Test Mode -> API Keys
# Without these, payments run in dev mode (no real money charged)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# ---- API Base URL (IMPORTANT for OAuth!) ----
# Set this to your Render backend URL. This is used to build OAuth callback URLs.
# Without this, OAuth redirects may break on Render (which sits behind a proxy).
API_BASE_URL=https://your-backend.onrender.com
